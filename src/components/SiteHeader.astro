---
import ThemeToggle from "./ThemeToggle.astro";
import { BASE } from "../utils/base";

export interface Props {
  showTagline?: boolean;
}

const { showTagline = false } = Astro.props;
const path = Astro.url.pathname;
const tagsActive = path.startsWith(`${BASE}tags`);
---

<header class="site-header">
  <p class="wordmark"><a href={BASE}>otro.blog.mas</a></p>
  <nav class="site-nav" aria-label="Principal">
    <a href={`${BASE}tags/`} aria-current={tagsActive ? "page" : undefined}>tags</a>
    <ThemeToggle />
  </nav>
  {showTagline && (
    <p class="tagline">
      <span>arte</span>
      <span>poesía</span>
      <span>tecnología</span>
      <span>hacktivismo</span>
      <span>DIY</span>
      <span>microcontroladores</span>
    </p>
  )}
</header>
