---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import { BASE } from "../utils/base";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "otro.blog.mas",
  description:
    "arte · poesía · tecnología · hacktivismo · DIY · microcontroladores",
  url: new URL(BASE, Astro.site ?? "https://hmoreirar.github.io").href,
  inLanguage: "es",
  publisher: { "@type": "Organization", name: "otro.blog.mas" },
};
---

<Base showTagline jsonLd={jsonLd}>
  <div class="shell">
    <div class="page-head">
      <h1>Índice</h1>
      <p>{posts.length} textos</p>
    </div>
    <PostList posts={posts} />
  </div>
</Base>
