---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { collectTags } from "../../utils/tags";
import { BASE } from "../../utils/base";

const posts = await getCollection("posts");
const tags = [...collectTags(posts).entries()].sort(([, a], [, b]) =>
  a.label.localeCompare(b.label, "es"),
);
---

<Base
  title="Tags"
  description="Todos los tags de otro.blog.mas: arte, poesía, tecnología, hacktivismo, DIY y microcontroladores."
>
  <div class="shell">
    <div class="page-head">
      <h1>Tags</h1>
      <p>{tags.length} tags · {posts.length} textos</p>
    </div>
    <ul class="tag-list">
      {tags.map(([key, { count, label }]) => (
        <li>
          <a class="tag-row" href={`${BASE}tags/${key}/`}>
            <span>{label}</span>
            <span class="tag-count">{count}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
