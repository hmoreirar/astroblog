---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { normalizeTag, tagLabel } from "../../utils/tags";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const tagPosts = new Map<string, typeof posts>();

  for (const post of posts) {
    const seen = new Set<string>();
    for (const tag of post.data.tags) {
      const normalized = normalizeTag(tag);
      if (!seen.has(normalized)) {
        seen.add(normalized);
        if (!tagPosts.has(normalized)) {
          tagPosts.set(normalized, []);
        }
        tagPosts.get(normalized)!.push(post);
      }
    }
  }

  return Array.from(tagPosts.entries()).map(([tag, taggedPosts]) => ({
    params: { tag },
    props: { tag, posts: taggedPosts },
  }));
}

const { tag, posts } = Astro.props;
const sortedPosts = [...posts].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const count = sortedPosts.length;
const label = tagLabel(tag);
---

<Base
  title={label}
  description={`Textos etiquetados con ${label} en otro.blog.mas.`}
>
  <div class="shell">
    <div class="page-head">
      <h1>{label}</h1>
      <p>{count} {count === 1 ? "texto" : "textos"}</p>
    </div>
    <PostList posts={sortedPosts} />
  </div>
</Base>
