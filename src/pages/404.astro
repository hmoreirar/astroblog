---
import Base from "../layouts/Base.astro";
import { BASE } from "../utils/base";
---

<Base
  title="Página no encontrada"
  description="La página que buscas no existe o cambió de sitio en otro.blog.mas."
>
  <div class="shell">
    <div class="page-head">
      <h1>404</h1>
      <p>no encontrada</p>
    </div>
    <div class="not-found">
      <p>La página que buscas no existe o cambió de sitio.</p>
      <a href={BASE}>Volver al índice</a>
    </div>
  </div>
</Base>
