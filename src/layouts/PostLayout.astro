---
import Base from "./Base.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import { formatDate } from "../utils/dateFormat";
import { tagLinks } from "../utils/tags";
import { BASE, asset, absolute } from "../utils/base";

export interface Props {
  title: string;
  date: Date;
  tags: string[];
  cover?: string;
  readingTime?: number;
}

const { title, date, tags, cover, readingTime } = Astro.props;
const iso = date.toISOString();
const description = `${title} — ensayo de otro.blog.mas sobre arte, poesía, tecnología, hacktivismo y DIY.`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: iso,
  dateModified: iso,
  inLanguage: "es",
  author: { "@type": "Person", name: "otro.blog.mas" },
  publisher: { "@type": "Organization", name: "otro.blog.mas" },
  url: new URL(Astro.url.pathname, Astro.site ?? "https://hmoreirar.github.io").href,
  image: cover ? absolute(cover) : undefined,
  keywords: tags.join(", "),
};
---

<Base
  title={title}
  description={description}
  ogType="article"
  image={cover}
  publishedTime={iso}
  keywords={tags}
  jsonLd={jsonLd}
>
  <ReadingProgress />
  <article class="article">
    <header class="post-header">
      <a class="backlink" href={BASE}>
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M19 12H5" />
          <path d="m11 18-6-6 6-6" />
        </svg>
        Índice
      </a>
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={iso}>{formatDate(date)}</time>
        {readingTime && (
          <>
            <span class="sep" aria-hidden="true">·</span>
            <span>{readingTime} min de lectura</span>
          </>
        )}
      </div>
      <p class="post-tags">
        {tagLinks(tags).map((tag) => (
          <a href={`${BASE}tags/${tag.key}/`}>{tag.label}</a>
        ))}
      </p>
    </header>
    {cover && <img class="cover" src={asset(cover)} alt={title} />}
    <div class="content">
      <slot />
    </div>
  </article>
</Base>
